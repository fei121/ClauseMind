# OpenAI-compatible LLM gateway
OPENAI_API_BASE=http://your-llm-gateway.example/v1
OPENAI_API_KEY=replace-me
OPENAI_CHAT_MODEL=openai/deepseek-v4-flash
OPENAI_EMBEDDING_MODEL=text-embedding-v4
OPENAI_MAX_TOKENS=2048

# Local experience mode: searchable PDFs use PDFium
LOCAL_DEMO_MODE=false
PDF_PARSER_MODE=local
MINERU_USE_REDIS=true
TRACING_METHOD=none
GENERAL_KB_ENABLED=false
SAVE_TO_DATABASE=true

# Local Redis
APP_TEST_REDIS_HOST=127.0.0.1
APP_TEST_REDIS_PORT=6379
APP_TEST_REDIS_DB=0
APP_TEST_REDIS_USER=
APP_TEST_REDIS_PASSWORD=

# Optional local MySQL persistence
APP_TEST_DB_HOST=127.0.0.1
APP_TEST_DB_PORT=3306
APP_TEST_DB_USER=demo
APP_TEST_DB_PASSWORD=change-me
APP_TEST_DB_NAME=clausemind_demo
APP_TEST_KB_HOST=127.0.0.1
APP_TEST_KB_PORT=3306
APP_TEST_KB_USER=demo
APP_TEST_KB_PASSWORD=change-me
APP_TEST_KB_DB=clausemind_knowledge

# The current demo uploader uses an S3/OSS-compatible bucket
APP_OSS_REGION=replace-me
APP_OSS_ACCESS_KEY_ID=replace-me
APP_OSS_ACCESS_KEY_SECRET=replace-me
APP_OSS_BUCKET_NAME=replace-me
APP_OSS_ENDPOINT=https://oss.example.com

# Optional MinerU OCR mode
MINERU_TOKEN_1=
MINERU_TOKEN_2=

# Optional asynchronous callback (use APP_PRD_ prefix when DEPLOY_ENV=prd)
APP_TEST_DECONSTRUCTION_CALLBACK_URL=
APP_TEST_CALLBACK_URL=

# Optional Langfuse observability
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_HOST=
LANGFUSE_PROMPT_LABEL=latest
